BOT_TOKEN=your_discord_bot_token
MASTER_KEY=your_litellm_master_key
LITELLM_BASE_URL=https://litellm.sam.co.th
# Local dev: set DB_PATH=users.db to use a file in the project root.
# For Docker/Coolify: DO NOT set DB_PATH — the bot uses /app/data/bot.db
