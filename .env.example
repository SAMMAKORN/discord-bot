BOT_TOKEN=your_bot_token_here
MASTER_KEY=your_litellm_master_key
LITELLM_BASE_URL=https://litellm.domain.ai
# Local defaults. Docker Compose overrides both paths to /app/data.
DB_PATH=users.db
ENCRYPTION_KEY_FILE=.encryption_key
# Production: inject a persistent key generated by Fernet.generate_key().
# ENCRYPTION_KEY=<base64_url_safe_32_byte_key>
